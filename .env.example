# Root environment variables (single source of truth).
# Copy this to .env and fill in the values. Loaded by apps/api via --env-file.

# Database (e.g. Neon connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dbname?sslmode=require"

# Auth
JWT_SECRET=change_me

# Admin seed (used by `bun prisma/seed.ts`)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me

# Server (optional — defaults shown)
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Code execution runner (ADR-0006). host = spawn the toolchain on the API host
# (default; dev is macOS without Docker). sandbox = one locked-down Docker
# container per execution. RUNNER=sandbox requires Docker + the sandbox image and
# fails loud at boot if either is missing — it NEVER silently falls back to host.
# Build the image: docker build -t labproctor-sandbox:latest apps/api/sandbox
RUNNER=host
# Sandbox tuning (only relevant when RUNNER=sandbox — defaults shown).
SANDBOX_IMAGE=labproctor-sandbox:latest
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=128
SANDBOX_WORKSPACE_SIZE=64m
# Global in-flight concurrency cap ≈ host memory budget ÷ SANDBOX_MEMORY. This is
# complementary to the per-user rate limiter (ADR-0005), not redundant.
SANDBOX_CONCURRENCY=4
SANDBOX_MAX_QUEUE=8
SANDBOX_QUEUE_TIMEOUT_MS=10000

# Frontend (apps/web). Read by Next.js from apps/web's own .env* (e.g.
# apps/web/.env.local), NOT loaded from this root file. Optional — defaults shown.
NEXT_PUBLIC_API_URL=http://localhost:4000
