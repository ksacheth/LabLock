  "cards": [
    {
      "dot": "cyan",
      "title": "Request pipeline",
      "items": [
        "Express 4 on Bun · PORT 4000 · CORS from apps/web",
        "auth → authorize → rate-limit → openSession on student routes",
        "Pure decision cores with thin Express/Prisma adapters (ADR-0003..0005)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Execution seam",
      "items": [
        "judge() is environment-blind: format → run → compare → score",
        "Host runner (default): gcc/g++/javac/python3 as child processes",
        "Sandbox runner: one docker run per execution — never falls back to host"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure semantics",
      "items": [
        "SYSTEM_ERROR = infra failure → 503 on run, quarantined on submit",
        "Platform ceiling breach surfaces as an ordinary RUNTIME_ERROR",
        "Sandbox preflight fails loud at boot (no silent host fallback)"
      ]
    },
    {
      "dot": "amber",
      "title": "Proctoring",
      "items": [
        "In-page lockdown: fullscreen, visibility, copy/paste, 3-strike ban",
        "Violations POSTed → ProctoringLog with 2s dedup",
        "3 strikes → ExamAttempt DISQUALIFIED"
      ]
    }
  ]
